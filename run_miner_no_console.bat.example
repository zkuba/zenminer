@echo off
REM =====================================================
REM ZenMiner - standard example (USER WALLET)
REM =====================================================
REM This file is an EXAMPLE.
REM Copy to run_miner.bat and adjust values below.
REM =====================================================

REM -----------------------------
REM DEFAULT POOL (low threshold - to set on webpage)
REM -----------------------------
set POOL=pool.hashvault.pro:443

REM -----------------------------
REM USER WALLET (REQUIRED - Dev as default)
REM -----------------------------
set WALLET=87QdreCSsmVC3s9SzctnPuMuEfupAivfdHCstLCKvQQiWtkhfoJFWH1fUMxu3am7Lh9eRHfKPVf5Gi5aKemLqBNpTEEc6oj

REM -----------------------------
REM WORKER NAME
REM -----------------------------
set WORKER=MyPC

REM -----------------------------
REM THREADS: active,idle,logged_out
REM NOTE: %% is required in BAT files
REM -----------------------------
set THREADS=15%%,30%%,80%%

REM -----------------------------
REM ACTIVITY TIMING (minutes / seconds)
REM -----------------------------
REM active -> idle after X minutes of no input
set IDLE_AFTER_MIN=2

REM idle -> logged_out after Y minutes of no input
REM (even if Windows does NOT report lock)
set LOGOUT_AFTER_MIN=15

REM debounce time (seconds)
set STATE_DEBOUNCE_SEC=10

REM -----------------------------
REM XMRig executable
REM Must be in PATH or same directory as ZenMiner.exe
REM -----------------------------
set XMRIG_BIN=xmrig.exe

REM -----------------------------
REM HTTP / API
REM -----------------------------
set HTTP_TOKEN=zenminer
set HTTP_PORT=5515
set XMRIG_HTTP_PORT=18080

REM -----------------------------
REM START ZENMINER
REM -----------------------------
start "" /B ^
  "ZenMiner-0.2.1.exe" ^
  -o %POOL% ^
  -u %WALLET% ^
  -p %WORKER% ^
  -t %THREADS% ^
  --idle-after-min %IDLE_AFTER_MIN% ^
  --logout-after-min %LOGOUT_AFTER_MIN% ^
  --state-debounce-sec %STATE_DEBOUNCE_SEC% ^
  --xmrig-path %XMRIG_BIN% ^
  --donate-level 2 ^
  --http-token %HTTP_TOKEN% ^
  --http-port %HTTP_PORT% ^
  --xmrig-http-port %XMRIG_HTTP_PORT%

exit

REM =====================================================
REM ONE-LINER (for quick copy / paste)
REM =====================================================
REM ZenMiner-0.2.1.exe -o pool.hashvault.pro:443 -u 87QdreCSsmVC3s9SzctnPuMuEfupAivfdHCstLCKvQQiWtkhfoJFWH1fUMxu3am7Lh9eRHfKPVf5Gi5aKemLqBNpTEEc6oj -p MyPC -t 15%%,30%%,80%% --idle-after-min 2 --logout-after-min 15 --state-debounce-sec 10 --xmrig-path xmrig.exe --donate-level 2 --http-token zenminer --http-port 5515 --xmrig-http-port 18080